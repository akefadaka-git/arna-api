# ARNA production environment template.
# Copy to the server as .env and fill every CHANGE-ME value securely.
# Never commit the completed server .env or place secrets in GitHub source.
APP_NAME="ARNA"
APP_ENV=production
APP_KEY=base64:CHANGE-ME-GENERATE-WITH-PHP-ARTISAN-KEY-GENERATE
APP_DEBUG=false
APP_URL=https://api.maalearna.com.et

APP_LOCALE=am
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=CHANGE-ME-DATABASE-HOST
DB_PORT=3306
DB_DATABASE=CHANGE-ME-ARNA-DATABASE
DB_USERNAME=CHANGE-ME-LEAST-PRIVILEGE-APPLICATION-USER
DB_PASSWORD=CHANGE-ME-UNIQUE-STRONG-DATABASE-PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# For MySQL TLS deployments, set MYSQL_ATTR_SSL_CA to the server CA file path.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.maalearna.com.et
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Cookie-authenticated first-party applications only. Keep these exact hosts
# synchronized with CORS_ALLOWED_ORIGINS; add other hosts only after approval.
SANCTUM_STATEFUL_DOMAINS=app.maalearna.com.et,portal.maalearna.com.et,admin.maalearna.com.et
CORS_ALLOWED_ORIGINS=https://app.maalearna.com.et,https://portal.maalearna.com.et,https://admin.maalearna.com.et
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=arna_

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=CHANGE-ME-SMTP-HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE-ME-SMTP-USERNAME
MAIL_PASSWORD=CHANGE-ME-SMTP-PASSWORD
MAIL_FROM_ADDRESS=CHANGE-ME-VERIFIED-SENDER
MAIL_FROM_NAME="ARNA"

# Use the real server values. Never put secrets in VITE_* variables.
